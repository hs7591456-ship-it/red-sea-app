/* =========================================================
   LOAD ADS
========================================================= */

async function loadAds(){

    const box =
        $("adsList");

    box.innerHTML =
        '<div class="loading">جاري التحميل...</div>';

    try{

        const data =
            await api(
                "/api/ads"
            );

        const ads =
            data.ads || [];

        $("adsCount").textContent =
            number(
                ads.length
            );

        if(!ads.length){

            box.innerHTML =
                '<div class="empty">لا توجد إعلانات</div>';

            return;

        }

        box.innerHTML =
            ads.map(
                ad => {

                    return `

                    <div class="item">

                        <div class="item-main">

                            <div class="item-title">

                                ${escapeHtml(
                                    ad.title ||
                                    "إعلان بدون عنوان"
                                )}

                            </div>

                            <div class="item-meta">

                                ${escapeHtml(
                                    ad.description ||
                                    ""
                                )}

                                <br>

                                رقم الإعلان:
                                ${escapeHtml(
                                    ad.adId ||
                                    ad.id ||
                                    "-"
                                )}

                                <br>

                                الترتيب:
                                ${number(
                                    ad.order
                                )}

                            </div>

                        </div>

                        <div class="item-actions">

                            <span class="badge">

                                ${
                                    ad.active !== false
                                    ? "فعال"
                                    : "متوقف"
                                }

                            </span>

                        </div>

                    </div>

                    `;

                }
            ).join("");

    }catch(error){

        box.innerHTML = `

            <div class="empty">

                تعذر تحميل الإعلانات

                <br>

                ${escapeHtml(
                    error.message
                )}

            </div>

        `;

    }

}

/* =========================================================
   LOGOUT
========================================================= */

async function logout(){

    try{

        if(adminToken){

            await fetch(
                API_BASE +
                "/api/admin/logout",
                {
                    method:"POST",

                    headers:{
                        "Content-Type":
                            "application/json",

                        "Authorization":
                            "Bearer " +
                            adminToken
                    }
                }
            );

        }

    }catch(error){

        console.error(error);

    }

    localStorage.removeItem(
        ADMIN_TOKEN_KEY
    );

    localStorage.removeItem(
        ADMIN_USER_KEY
    );

    adminToken =
        null;

    window.location.replace(
        "admin-login.html"
    );

}

/* =========================================================
   HOME
========================================================= */

function goHome(){

    window.location.href =
        "home.html";

}

/* =========================================================
   START
========================================================= */

async function startAdmin(){

    const valid =
        await checkAdminSession();

    if(!valid){

        return;

    }

    await Promise.allSettled([

        loadRooms(),

        loadAgencies(),

        loadShippingAgencies(),

        loadAds()

    ]);

}

startAdmin();

</script>

