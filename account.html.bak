<!DOCTYPE html>
<html lang="ar" dir="rtl">

<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1.0">

<title>Red Sea - لوحة الإدارة</title>

<style>

*{
    box-sizing:border-box;
    margin:0;
    padding:0;
    font-family:Arial,Tahoma,sans-serif;
}

body{
    background:#07111f;
    color:#fff;
    min-height:100vh;
}

button,input{
    font:inherit;
}

button{
    cursor:pointer;
}

.topbar{
    position:sticky;
    top:0;
    z-index:50;
    background:#0b1829;
    border-bottom:1px solid #1b314b;
    padding:16px;
}

.topbar-inner{
    max-width:1200px;
    margin:auto;
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:15px;
}

.brand{
    display:flex;
    align-items:center;
    gap:12px;
}

.logo{
    width:46px;
    height:46px;
    border-radius:14px;
    object-fit:cover;
}

.brand h1{
    font-size:20px;
}

.brand p{
    color:#8fa8c2;
    font-size:12px;
    margin-top:4px;
}

.owner-box{
    display:flex;
    align-items:center;
    gap:10px;
}

.owner-avatar{
    width:42px;
    height:42px;
    border-radius:50%;
    background:#163452;
    display:flex;
    align-items:center;
    justify-content:center;
    font-weight:bold;
}

.container{
    max-width:1200px;
    margin:auto;
    padding:20px 15px 50px;
}

.welcome{
    background:linear-gradient(135deg,#102b47,#0c1b2e);
    border:1px solid #1d3c5c;
    border-radius:22px;
    padding:22px;
    margin-bottom:20px;
}

.welcome h2{
    font-size:24px;
    margin-bottom:7px;
}

.welcome p{
    color:#9db1c8;
}

.grid{
    display:grid;
    grid-template-columns:repeat(4,1fr);
    gap:14px;
    margin-bottom:22px;
}

.stat{
    background:#0c1a2b;
    border:1px solid #1a3049;
    border-radius:18px;
    padding:18px;
}

.stat-title{
    color:#8ea6bf;
    font-size:13px;
    margin-bottom:10px;
}

.stat-value{
    font-size:25px;
    font-weight:bold;
}

.section{
    background:#0b1829;
    border:1px solid #1a3049;
    border-radius:20px;
    margin-bottom:18px;
    overflow:hidden;
}

.section-head{
    padding:17px;
    border-bottom:1px solid #1a3049;
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:10px;
}

.section-head h3{
    font-size:18px;
}

.section-head span{
    color:#8199b2;
    font-size:12px;
}

.section-body{
    padding:17px;
}

.form-grid{
    display:grid;
    grid-template-columns:repeat(2,1fr);
    gap:12px;
}

.field{
    display:flex;
    flex-direction:column;
    gap:7px;
}

.field label{
    color:#9eb2c8;
    font-size:13px;
}

.field input{
    width:100%;
    background:#071321;
    border:1px solid #203a55;
    color:#fff;
    outline:none;
    border-radius:12px;
    padding:13px;
}

.field input:focus{
    border-color:#397bb2;
}

.full{
    grid-column:1/-1;
}

.btn{
    border:0;
    border-radius:12px;
    padding:12px 17px;
    background:#1769aa;
    color:#fff;
    font-weight:bold;
}

.btn:hover{
    filter:brightness(1.12);
}

.btn-danger{
    background:#a92d3b;
}

.btn-success{
    background:#287b56;
}

.btn-secondary{
    background:#24394f;
}

.actions{
    display:flex;
    flex-wrap:wrap;
    gap:9px;
    margin-top:13px;
}

.result{
    margin-top:13px;
    padding:12px;
    border-radius:12px;
    background:#071321;
    color:#9fb4c9;
    display:none;
    white-space:pre-wrap;
}

.list{
    display:flex;
    flex-direction:column;
    gap:10px;
}

.item{
    background:#071321;
    border:1px solid #1b324b;
    border-radius:15px;
    padding:14px;
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:15px;
}

.item-main{
    min-width:0;
}

.item-title{
    font-weight:bold;
    margin-bottom:5px;
}

.item-meta{
    color:#819ab3;
    font-size:12px;
    line-height:1.7;
}

.item-actions{
    display:flex;
    gap:7px;
    flex-wrap:wrap;
}

.badge{
    display:inline-block;
    padding:5px 9px;
    border-radius:20px;
    background:#18334d;
    color:#9fc7e8;
    font-size:11px;
}

.badge-owner{
    background:#473617;
    color:#f1c96b;
}

.badge-admin{
    background:#193e38;
    color:#80d5bc;
}

.badge-banned{
    background:#4b2028;
    color:#ff9aa7;
}

.empty{
    text-align:center;
    color:#718aa3;
    padding:25px 10px;
}

.loading{
    text-align:center;
    color:#8ca5bd;
    padding:20px;
}

.error{
    background:#3a1d24;
    border:1px solid #71323d;
    color:#ffb0ba;
    padding:12px;
    border-radius:12px;
    margin-bottom:15px;
    display:none;
}

.toast{
    position:fixed;
    left:15px;
    bottom:20px;
    z-index:100;
    background:#10253b;
    border:1px solid #2a4a68;
    color:#fff;
    padding:13px 17px;
    border-radius:13px;
    display:none;
    max-width:90%;
}

.logout{
    background:#54232b;
}

.permission-box{
    background:#071321;
    border:1px solid #203a55;
    border-radius:14px;
    padding:14px;
}

.permission-title{
    color:#9eb2c8;
    font-size:13px;
    margin-bottom:12px;
}

.permissions{
    display:grid;
    grid-template-columns:repeat(2,1fr);
    gap:9px;
}

.permission{
    display:flex;
    align-items:center;
    gap:8px;
    background:#0b1b2c;
    border:1px solid #1b344d;
    border-radius:10px;
    padding:10px;
    color:#d5e1ed;
    font-size:13px;
}

.permission input{
    width:17px;
    height:17px;
    accent-color:#1769aa;
}

@media(max-width:900px){

    .grid{
        grid-template-columns:repeat(2,1fr);
    }

}

@media(max-width:650px){

    .topbar-inner{
        align-items:flex-start;
    }

    .owner-box{
        display:none;
    }

    .form-grid{
        grid-template-columns:1fr;
    }

    .full{
        grid-column:auto;
    }

    .grid{
        grid-template-columns:repeat(2,1fr);
        gap:9px;
    }

    .stat{
        padding:14px;
    }

    .stat-value{
        font-size:20px;
    }

    .item{
        align-items:flex-start;
        flex-direction:column;
    }

    .item-actions{
        width:100%;
    }

    .item-actions .btn{
        flex:1;
    }

    .permissions{
        grid-template-columns:1fr;
    }

}

</style>

</head>

<body>

<header class="topbar">

<div class="topbar-inner">

<div class="brand">

<img
src="logo.png"
class="logo"
onerror="this.style.display='none'"
>

<div>

<h1>Red Sea</h1>

<p>لوحة تحكم الإدارة 👑</p>

</div>

</div>

<div class="owner-box">

<div>

<div id="ownerName">
جاري التحميل...
</div>

<div
id="ownerRole"
style="font-size:11px;color:#7891aa"
>
</div>

</div>

<div
class="owner-avatar"
id="ownerAvatar"
>
R
</div>

</div>

</div>

</header>

<main class="container">

<div
id="errorBox"
class="error"
></div>

<section class="welcome">

<h2>
أهلاً بك في لوحة إدارة Red Sea 👑
</h2>

<p>
من هنا تقدر تتحكم في المستخدمين والوكالات والشحن والإعلانات والغرف.
</p>

</section>

<div class="grid">

<div class="stat">

<div class="stat-title">
الغرف الحالية
</div>

<div
class="stat-value"
id="roomsCount"
>
0
</div>

</div>

<div class="stat">

<div class="stat-title">
الوكالات العادية
</div>

<div
class="stat-value"
id="agenciesCount"
>
0
</div>

</div>

<div class="stat">

<div class="stat-title">
وكالات الشحن
</div>

<div
class="stat-value"
id="shippingCount"
>
0
</div>

</div>

<div class="stat">

<div class="stat-title">
الإعلانات
</div>

<div
class="stat-value"
id="adsCount"
>
0
</div>

</div>

</div>

<!-- CREATE NORMAL AGENCY -->

<section class="section">

<div class="section-head">

<h3>
🏢 إنشاء وكالة عادية
</h3>

<span>
Owner / Admin
</span>

</div>

<div class="section-body">

<div class="form-grid">

<div class="field">

<label>
اسم الوكالة
</label>

<input
id="agencyName"
type="text"
placeholder="مثال: وكالة البحر"
>

</div>

<div class="field">

<label>
ID صاحب الوكالة - 8 أرقام
</label>

<input
id="agencyOwnerId"
type="text"
inputmode="numeric"
maxlength="8"
placeholder="12345678"
>

</div>

</div>

<div class="actions">

<button
class="btn"
onclick="createAgency()"
>
إنشاء الوكالة
</button>

</div>

<div
id="agencyResult"
class="result"
></div>

</div>

</section>

<!-- SHIPPING -->

<section class="section">

<div class="section-head">

<h3>
🚚 إنشاء وكالة شحن
</h3>

<span>
Owner فقط
</span>

</div>

<div class="section-body">

<div class="form-grid">

<div class="field">

<label>
اسم وكالة الشحن
</label>

<input
id="shippingName"
type="text"
placeholder="مثال: شحن Red Sea"
>

</div>

<div class="field">

<label>
رقم المستخدم 8 أرقام
</label>

<input
id="shippingUserId"
type="text"
inputmode="numeric"
maxlength="8"
placeholder="12345678"
>

</div>

</div>

<div class="actions">

<button
class="btn"
onclick="createShippingAgency()"
>
إنشاء وكالة الشحن
</button>

</div>

<div
id="shippingResult"
class="result"
></div>

</div>

</section>

<!-- ADMIN -->

<section class="section">

<div class="section-head">

<h3>
🛡️ إنشاء حساب مدير
</h3>

<span>
Owner فقط
</span>

</div>

<div class="section-body">

<div class="form-grid">

<div class="field">

<label>
اسم المستخدم
</label>

<input
id="adminUsername"
type="text"
autocomplete="off"
placeholder="مثال: ahmed"
>

</div>

<div class="field">

<label>
اسم المدير
</label>

<input
id="adminName"
type="text"
autocomplete="off"
placeholder="مثال: أحمد"
>

</div>

<div class="field">

<label>
كلمة المرور
</label>

<input
id="adminPassword"
type="password"
autocomplete="new-password"
placeholder="6 أحرف أو أكثر"
>

</div>

<div class="field">

<label>
تأكيد كلمة المرور
</label>

<input
id="adminPasswordConfirm"
type="password"
autocomplete="new-password"
placeholder="اكتب كلمة المرور مرة أخرى"
>

</div>

<div class="field full">

<div class="permission-box">

<div class="permission-title">
حدد بالضبط الأقسام التي يستطيع المدير الوصول إليها:
</div>

<div class="permissions">

<label class="permission">
<input
type="checkbox"
class="admin-permission"
value="users"
>
المستخدمين
</label>

<label class="permission">
<input
type="checkbox"
class="admin-permission"
value="rooms"
>
الغرف
</label>

<label class="permission">
<input
type="checkbox"
class="admin-permission"
value="agencies"
>
الوكالات
</label>

<label class="permission">
<input
type="checkbox"
class="admin-permission"
value="ads"
>
الإعلانات
</label>

<label class="permission">
<input
type="checkbox"
class="admin-permission"
value="banUsers"
>
حظر المستخدمين
</label>

<label class="permission">
<input
type="checkbox"
class="admin-permission"
value="transactions"
>
المعاملات
</label>

<label class="permission">
<input
type="checkbox"
class="admin-permission"
value="shipping"
>
الشحن
</label>

<label class="permission">
<input
type="checkbox"
class="admin-permission"
value="reports"
>
التقارير
</label>

</div>

</div>

</div>

</div>

<div class="actions">

<button
class="btn btn-success"
onclick="makeAdmin()"
>
إنشاء حساب المدير
</button>

<button
class="btn btn-secondary"
onclick="selectAllPermissions()"
>
تحديد الكل
</button>

<button
class="btn btn-secondary"
onclick="clearPermissions()"
>
إلغاء الكل
</button>

</div>

<div
id="adminResult"
class="result"
></div>

</div>

</section>

<!-- ADS -->

<section class="section">

<div class="section-head">

<h3>
📢 إضافة إعلان
</h3>

<span>
Owner فقط
</span>

</div>

<div class="section-body">

<div class="form-grid">

<div class="field">

<label>
عنوان الإعلان
</label>

<input
id="adTitle"
type="text"
placeholder="عنوان الإعلان"
>

</div>

