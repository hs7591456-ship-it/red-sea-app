<label>
ترتيب الإعلان
</label>

<input
id="adOrder"
type="number"
value="0"
>

</div>

<div class="field full">

<label>
الوصف
</label>

<input
id="adDescription"
type="text"
placeholder="وصف مختصر للإعلان"
>

</div>

<div class="field full">

<label>
رابط صورة الإعلان
</label>

<input
id="adImage"
type="url"
placeholder="https://..."
>

</div>

</div>

<div class="actions">

<button
class="btn"
onclick="createAd()"
>
نشر الإعلان
</button>

</div>

<div
id="adResult"
class="result"
></div>

</div>

</section>

<!-- SHIPPING LIST -->

<section class="section">

<div class="section-head">

<h3>
🚚 وكالات الشحن
</h3>

<button
class="btn btn-secondary"
onclick="loadShippingAgencies()"
>
تحديث
</button>

</div>

<div class="section-body">

<div
id="shippingList"
class="list"
>

<div class="loading">
جاري التحميل...
</div>

</div>

</div>

</section>

<!-- AGENCIES -->

<section class="section">

<div class="section-head">

<h3>
🏢 الوكالات العادية
</h3>

<button
class="btn btn-secondary"
onclick="loadAgencies()"
>
تحديث
</button>

</div>

<div class="section-body">

<div
id="agencyList"
class="list"
>

<div class="loading">
جاري التحميل...
</div>

</div>

</div>

</section>

<!-- ROOMS -->

<section class="section">

<div class="section-head">

<h3>
🏠 الغرف
</h3>

<button
class="btn btn-secondary"
onclick="loadRooms()"
>
تحديث
</button>

</div>

<div class="section-body">

<div
id="roomList"
class="list"
>

<div class="loading">
جاري التحميل...
</div>

</div>

</div>

</section>

<!-- ADS LIST -->

<section class="section">

<div class="section-head">

<h3>
📢 الإعلانات الحالية
</h3>

<button
class="btn btn-secondary"
onclick="loadAds()"
>
تحديث
</button>

</div>

<div class="section-body">

<div
id="adsList"
class="list"
>

<div class="loading">
جاري التحميل...
</div>

</div>

</div>

</section>

<div class="actions">

<button
class="btn btn-secondary"
onclick="goHome()"
>
🏠 العودة للرئيسية
</button>

<button
class="btn logout"
onclick="logout()"
>
تسجيل الخروج
</button>

</div>

</main>

<div
id="toast"
class="toast"
></div>

<script>

/* =========================================================
   ADMIN SESSION
========================================================= */

const API_BASE =
"https://red-sea-server.onrender.com";

const ADMIN_TOKEN_KEY =
"redsea_admin_token";

const ADMIN_USER_KEY =
"redsea_admin_user";

let adminToken =
localStorage.getItem(ADMIN_TOKEN_KEY);

let adminUser = null;

try{

    adminUser =
        JSON.parse(
            localStorage.getItem(ADMIN_USER_KEY) || "{}"
        );

}catch(error){

    adminUser = {};

}

/* =========================================================
   HELPERS
========================================================= */

function $(id){

    return document.getElementById(id);

}

function clean(value){

    return String(value ?? "").trim();

}

function escapeHtml(value){

    return String(value ?? "")
        .replace(/&/g,"&amp;")
        .replace(/</g,"&lt;")
        .replace(/>/g,"&gt;")
        .replace(/"/g,"&quot;")
        .replace(/'/g,"&#039;");

}

function number(value){

    return Number(value || 0)
        .toLocaleString("en-US");

}

function showToast(message){

    const box = $("toast");

    box.textContent =
        message;

    box.style.display =
        "block";

    setTimeout(()=>{

        box.style.display =
            "none";

    },3000);

}

function showResult(id,message){

    const box =
        $(id);

    box.textContent =
        message;

    box.style.display =
        "block";

}

function showError(message){

    const box =
        $("errorBox");

    box.textContent =
        message;

    box.style.display =
        "block";

}

function hideError(){

    $("errorBox").style.display =
        "none";

}

/* =========================================================
   ADMIN API
========================================================= */

async function api(path,options={}){

    const headers = {

        "Content-Type":
            "application/json",

        ...(options.headers || {})

    };

    if(adminToken){

        headers.Authorization =
            "Bearer " + adminToken;

    }

    let response;

    try{

        response =
            await fetch(
                API_BASE + path,
                {
                    ...options,
                    headers
                }
            );

    }catch(error){

        throw new Error(
            "تعذر الاتصال بالسيرفر"
        );

    }

    let data = null;

    try{

        data =
            await response.json();

    }catch(error){

        data = {};

    }

    if(
        response.status === 401 ||
        response.status === 403
    ){

        localStorage.removeItem(
            ADMIN_TOKEN_KEY
        );

        localStorage.removeItem(
            ADMIN_USER_KEY
        );

        window.location.href =
            "admin-login.html";

        throw new Error(
            "انتهت جلسة الإدارة"
        );

    }

    if(!response.ok){

        throw new Error(
            data.message ||
            "حدث خطأ في السيرفر"
        );

    }

    return data;

}

/* =========================================================
   CHECK ADMIN SESSION
========================================================= */

async function checkAdminSession(){

    if(!adminToken){

        window.location.replace(
            "admin-login.html"
        );

        return false;

    }

    try{

        const data =
            await api(
                "/api/admin/me"
            );

        if(!data.success){

            throw new Error(
                "جلسة الإدارة غير صالحة"
            );

        }

        adminUser =
            data.admin ||
            data.user ||
            adminUser ||
            {};

        localStorage.setItem(
            ADMIN_USER_KEY,
            JSON.stringify(adminUser)
        );

        $("ownerName").textContent =
            adminUser.name ||
            adminUser.username ||
            "مدير النظام";

        $("ownerRole").textContent =
            adminUser.role ||
            "ADMIN";

        $("ownerAvatar").textContent =
            (
                adminUser.name ||
                adminUser.username ||
                "R"
            )
            .charAt(0)
            .toUpperCase();

        return true;

    }catch(error){

        console.error(error);

        if(!adminToken){

            return false;

        }

        showError(
            "تعذر التحقق من جلسة الإدارة: " +
            error.message
        );

        return false;

    }

}

/* =========================================================
   CREATE AGENCY
========================================================= */

async function createAgency(){

    hideError();

    const name =
        clean(
            $("agencyName").value
        );

    const ownerId =
        clean(
            $("agencyOwnerId").value
        );

    if(!name){

        showToast(
            "اكتب اسم الوكالة أولاً"
        );

        return;

    }

    if(!/^\d{8}$/.test(ownerId)){

        showToast(
            "ID صاحب الوكالة لازم يكون 8 أرقام"
        );

        return;

    }

    try{

        const data =
            await api(
                "/api/agencies",
                {
                    method:"POST",

                    body:JSON.stringify({
                        name,
                        ownerId
                    })
                }
            );

        showResult(
            "agencyResult",

            "تم إنشاء الوكالة بنجاح\n" +
            "اسم الوكالة: " +
            (
                data.agency?.name ||
                name
            ) +
            "\nرقم الوكالة: " +
            (
                data.agency?.agencyId ||
                data.agency?.id ||
                "-"
            ) +
            "\nصاحب الوكالة: " +
            (
                data.agency?.ownerId ||
                ownerId
            )
        );

        $("agencyName").value =
            "";

        $("agencyOwnerId").value =
            "";

        showToast(
            "تم إنشاء الوكالة وربطها بالحساب"
        );

        loadAgencies();

    }catch(error){

        showResult(
            "agencyResult",

            "فشل إنشاء الوكالة: " +
            error.message
        );

    }

}

/* =========================================================
   CREATE SHIPPING AGENCY
========================================================= */

async function createShippingAgency(){

    hideError();

    const name =
        clean(
            $("shippingName").value
        );

    const userId =
        clean(
            $("shippingUserId").value
        );

    if(!name){

        showToast(
            "اكتب اسم وكالة الشحن"
        );

        return;

    }

    if(!/^\d{8}$/.test(userId)){

        showToast(
            "رقم المستخدم لازم يكون 8 أرقام"
        );

        return;

    }

    try{

        const data =
            await api(
                "/api/shipping-agencies",
                {
                    method:"POST",

                    body:JSON.stringify({
                        name,
                        userId
                    })
                }
            );

        showResult(
            "shippingResult",

            "تم إنشاء وكالة الشحن بنجاح\n" +
            "رقم الوكالة: " +
            (
                data.agency?.agencyId ||
                data.agency?.id ||
                "-"
            )
        );

        $("shippingName").value =
            "";

        $("shippingUserId").value =
            "";

        showToast(
            "تم إنشاء وكالة الشحن"
        );

        loadShippingAgencies();

    }catch(error){

        showResult(
            "shippingResult",

            "فشل إنشاء وكالة الشحن: " +
            error.message
        );

    }

}

/* =========================================================
   PERMISSIONS
========================================================= */

function getSelectedPermissions(){

    return Array.from(
        document.querySelectorAll(
            ".admin-permission:checked"
        )
    ).map(
        checkbox =>
            checkbox.value
    );

}

function selectAllPermissions(){

    document
        .querySelectorAll(
            ".admin-permission"
        )
        .forEach(
            checkbox =>
                checkbox.checked = true
        );

}

function clearPermissions(){

    document
        .querySelectorAll(
            ".admin-permission"
        )
        .forEach(
            checkbox =>
                checkbox.checked = false
        );

}

/* =========================================================
   CREATE ADMIN
========================================================= */

async function makeAdmin(){

    hideError();

    const username =
        clean(
            $("adminUsername").value
        );

    const name =
        clean(
            $("adminName").value
        );

    const password =
        String(
            $("adminPassword").value ||
            ""
        );

    const confirmPassword =
        String(
            $("adminPasswordConfirm").value ||
            ""
        );

    const permissions =
        getSelectedPermissions();

    if(!username){

        showToast(
            "اكتب اسم المستخدم"
        );

        return;

    }

    if(!password){

        showToast(
            "اكتب كلمة المرور"
        );

        return;

    }

    if(password.length < 6){

        showToast(
            "كلمة المرور لازم تكون 6 أحرف أو أكثر"
        );

        return;

    }

    if(password !== confirmPassword){

        showToast(
            "كلمتا المرور غير متطابقتين"
        );

        return;

    }

    if(!permissions.length){

        showToast(
            "حدد صلاحية واحدة على الأقل"
        );

        return;

    }

    try{

        const data =
            await api(
                "/api/owner/admins",
                {
                    method:"POST",

                    body:JSON.stringify({

                        username,
                        name:
                            name || username,
                        password,
                        permissions

                    })
                }
            );

        const created =
            data.admin || {};

        showResult(
            "adminResult",

            "تم إنشاء حساب المدير بنجاح\n" +
            "اسم المستخدم: " +
            (
                created.username ||
                username
            ) +
            "\nالصلاحيات: " +
            permissions.join("، ")
        );

        $("adminUsername").value =
            "";

        $("adminName").value =
            "";

        $("adminPassword").value =
            "";

        $("adminPasswordConfirm").value =
            "";

        clearPermissions();

        showToast(
            "تم إنشاء حساب المدير"
        );

    }catch(error){

        showResult(
            "adminResult",

            "فشل إنشاء حساب المدير: " +
            error.message
        );

    }

}

/* =========================================================
   CREATE AD
========================================================= */

async function createAd(){

    hideError();

    const title =
        clean(
            $("adTitle").value
        );

    const description =
        clean(
            $("adDescription").value
        );

    const imageUrl =
        clean(
            $("adImage").value
        );

    const order =
        Number(
            $("adOrder").value || 0
        );

    if(!title && !imageUrl){

        showToast(
            "اكتب عنوان الإعلان أو رابط الصورة"
        );

        return;

    }

    try{

        const data =
            await api(
                "/api/ads",
                {
                    method:"POST",

                    body:JSON.stringify({

                        title,
                        description,
                        imageUrl,
                        order

                    })
                }
            );

        showResult(
            "adResult",

            "تم نشر الإعلان بنجاح\n" +
            "رقم الإعلان: " +
            (
                data.ad?.adId ||
                data.ad?.id ||
                "-"
            )
        );

        $("adTitle").value =
            "";

        $("adDescription").value =
            "";

        $("adImage").value =
            "";

        $("adOrder").value =
            "0";

        showToast(
            "تم نشر الإعلان"
        );

        loadAds();

    }catch(error){

        showResult(
            "adResult",

            "فشل نشر الإعلان: " +
            error.message
        );

    }

}

/* =========================================================
   LOAD ROOMS
========================================================= */

async function loadRooms(){

    const box =
        $("roomList");

    box.innerHTML =
        '<div class="loading">جاري التحميل...</div>';

    try{

        const data =
            await api(
                "/api/rooms"
            );

        const rooms =
            data.rooms || [];

        $("roomsCount").textContent =
            number(
                rooms.length
            );

        if(!rooms.length){

            box.innerHTML =
                '<div class="empty">لا توجد غرف حالياً</div>';

            return;

        }

        box.innerHTML =
            rooms.map(
                room => {

                    return `

                    <div class="item">

                        <div class="item-main">

                            <div class="item-title">

                                ${escapeHtml(
                                    room.name ||
                                    "غرفة بدون اسم"
                                )}

                            </div>

                            <div class="item-meta">

                                رقم الغرفة:
                                ${escapeHtml(
                                    room.roomId ||
                                    "-"
                                )}

                                <br>

                                المالك:
                                ${escapeHtml(
                                    room.ownerId ||
                                    "-"
                                )}

                                <br>

                                الأعضاء:
                                ${number(
                                    room.membersCount
                                )}

                            </div>

                        </div>

                        <div class="item-actions">

                            <span class="badge">

                                ${
                                    room.active !== false
                                    ? "نشطة"
                                    : "متوقفة"
                                }

                            </span>

                        </div>

                    </div>

                    `;

                }
            ).join("");

    }catch(error){

        box.innerHTML = `

            <div class="empty">

                تعذر تحميل الغرف

                <br>

                ${escapeHtml(
                    error.message
                )}

            </div>

        `;

    }

}

/* =========================================================
   LOAD AGENCIES
========================================================= */

async function loadAgencies(){

    const box =
        $("agencyList");

    box.innerHTML =
        '<div class="loading">جاري التحميل...</div>';

    try{

        const data =
            await api(
                "/api/agencies/top?limit=50"
            );

        const agencies =
            data.agencies || [];

        $("agenciesCount").textContent =
            number(
                agencies.length
            );

        if(!agencies.length){

            box.innerHTML =
                '<div class="empty">لا توجد وكالات عادية</div>';

            return;

        }

        box.innerHTML =
            agencies.map(
                (agency,index) => {

                    return `

                    <div class="item">

                        <div class="item-main">

                            <div class="item-title">

                                #${index + 1}

                                ${escapeHtml(
                                    agency.name ||
                                    "وكالة"
                                )}

                            </div>

                            <div class="item-meta">

                                رقم الوكالة:
                                ${escapeHtml(
                                    agency.agencyId ||
                                    "-"
                                )}

                                <br>

                                المالك:
                                ${escapeHtml(
                                    agency.ownerId ||
                                    "-"
                                )}

                                <br>

                                العملات:
                                ${number(
                                    agency.coins
                                )}

                            </div>

                        </div>

                        <div class="item-actions">

                            <span class="badge">

                                وكالة عادية

                            </span>

                        </div>

                    </div>

                    `;

                }
            ).join("");

    }catch(error){

        box.innerHTML = `

            <div class="empty">

                تعذر تحميل الوكالات

                <br>

                ${escapeHtml(
                    error.message
                )}

            </div>

        `;

    }

}

